generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Associado {
  id                     String    @id @default(uuid())
  cpfCnpj                String    @unique @map("cpf_cnpj")
  nome                   String
  telefone               String
  email                  String?
  emNegociacao           Boolean   @default(false) @map("em_negociacao")
  observacao             String?
  observacaoAtualizadaEm DateTime? @map("observacao_atualizada_em")
  bloqueado              Boolean   @default(false)
  emJuridico             Boolean   @default(false) @map("em_juridico")
  cicloResetadoEm        DateTime? @map("ciclo_resetado_em")
  criadoEm               DateTime  @default(now()) @map("criado_em")
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em")

  cobrancas           Cobranca[]
  historicoNegociacao HistoricoNegociacao[]
  historicoBloqueio   HistoricoBloqueio[]

  @@index([cpfCnpj])
  @@map("associados")
}

model Cobranca {
  id             String    @id @default(uuid())
  associadoId    String    @map("associado_id")
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  idExterno      String?   @unique @map("id_externo")
  valor          Decimal   @db.Decimal(12, 2)
  vencimento     DateTime  @db.Date
  diasDiferenca  Int       @map("dias_diferenca")
  linkPagamento  String?   @map("link_pagamento")
  descricao      String?
  status         String    @default("pending")
  sincronizadoEm DateTime  @default(now()) @map("sincronizado_em")

  @@index([associadoId])
  @@index([status])
  @@index([idExterno])
  @@map("cobrancas")
}

model HistoricoNegociacao {
  id             String    @id @default(uuid())
  associadoId    String    @map("associado_id")
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  statusAnterior Boolean   @map("status_anterior")
  statusNovo     Boolean   @map("status_novo")
  alteradoEm     DateTime  @default(now()) @map("alterado_em")

  @@index([associadoId])
  @@map("historico_negociacao")
}

model HistoricoBloqueio {
  id             String    @id @default(uuid())
  associadoId    String    @map("associado_id")
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  statusAnterior Boolean   @map("status_anterior")
  statusNovo     Boolean   @map("status_novo")
  alteradoEm     DateTime  @default(now()) @map("alterado_em")

  @@index([associadoId])
  @@map("historico_bloqueio")
}

/// Tabela de configurações persistidas em runtime (ex.: API_KEY atual),
/// para permitir leitura/alteração sem depender só de variáveis de ambiente.
model Configuracao {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes")
}

/// Registro de cada execução de POST /api/sync, usado por GET /api/config/sync-log.
model SyncLog {
  id                         String   @id @default(uuid())
  executadoEm                DateTime @default(now()) @map("executado_em")
  totalAssociadosProcessados Int      @map("total_associados_processados")
  sucesso                    Boolean

  @@index([executadoEm])
  @@map("sync_log")
}

/// Registro de cada envio do fluxo de Cadastro/Faturamento (substitui o
/// gatilho do Kommo) — guarda o payload completo enviado pelo formulário e
/// o resultado do repasse para o webhook do n8n (ver POST /api/cadastros).
model CadastroEnviado {
  id          String   @id @default(uuid())
  payload     Json
  status      String   @default("enviado")
  respostaN8n String?  @map("resposta_n8n")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([status])
  @@map("cadastros_enviados")
}

/// Lista manual de cobranças do Asaas a excluir do cálculo de Taxa de
/// Inadimplência (ver GET /api/inadimplencia/resumo), independente da
/// exclusão automática por palavra-chave (ver "configuracoes" ->
/// "inadimplencia_palavras_excluidas"). Gerenciada via
/// GET/POST/DELETE /api/inadimplencia/exclusoes.
model CobrancaIgnorada {
  id             String   @id @default(uuid())
  asaasPaymentId String   @unique @map("asaas_payment_id")
  motivo         String?
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@map("cobrancas_ignoradas")
}
