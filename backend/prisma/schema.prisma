generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Franquia (unidade Via Permuta) — base do isolamento multi-tenant (ver
/// docs/plano-multi-franquia.md). Cada franquia tem seus próprios dados e
/// credenciais/integrações (seção 3 do plano), compartilhadas por todos os
/// usuários dela. Desde o ajuste "Super Admin pode adicionar mais de 1
/// usuário numa franquia" (ver docs/plano-multi-franquia.md, seção 8, item
/// 8), uma franquia pode ter 0 (só na prática impossível — toda franquia
/// nasce com 1 usuário titular), 1 ou N usuários — a trava de
/// @@unique([franquiaId]) em Usuario foi removida. SUPER_ADMIN é a única
/// exceção, sem franquia própria, com acesso a todas.
model Franquia {
  id       String   @id @default(uuid())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  /// LEGADO — restrição de telas ficava aqui até o ajuste "Super Admin pode
  /// adicionar mais de 1 usuário numa franquia" (ver
  /// docs/plano-multi-franquia.md, seção 8, item 8). Como agora pessoas
  /// diferentes da mesma franquia podem ter telas liberadas diferentes, o
  /// controle de verdade passou pra Usuario.recursosPermitidos — nada no
  /// código lê mais este campo (nem exigirRecurso.js, nem
  /// franquias.controller.js). Mantido só pra não exigir uma migração
  /// destrutiva (DROP COLUMN); a migração que fez a troca já copiou o valor
  /// daqui pro Usuario único que existia em cada franquia até então, então
  /// o dado antigo está preservado nos dois lugares no momento da troca —
  /// só o daqui é que para de ser atualizado a partir de agora.
  recursosPermitidos String[] @default([]) @map("recursos_permitidos")

  usuarios               Usuario[]
  associados             Associado[]
  cadastrosEnviados      CadastroEnviado[]
  modelosContrato        ModeloContrato[]
  cobrancasIgnoradas     CobrancaIgnorada[]
  syncLogs               SyncLog[]
  apiKeys                ApiKey[]
  configuracoes          Configuracao[]
  etapasJuridico         EtapaJuridico[]
  cardsJuridico          CardJuridico[]
  historicosCardJuridico HistoricoCardJuridico[]

  @@map("franquias")
}

/// Usuário do painel — substitui o antigo login único via ADMIN_USER/
/// ADMIN_PASSWORD (ver docs/plano-multi-franquia.md, seção 2, e
/// src/services/refreshTokens.service.js). "papel": "SUPER_ADMIN" (sem
/// franquia, vê todas) ou "FRANQUIA" (acesso completo aos DADOS da própria
/// franquia — Dashboard/Cadastro/Contratos/Inadimplência/Jurídico/
/// Configurações continuam compartilhados por todos os usuários da mesma
/// franquia; o que varia por usuário são as TELAS liberadas, ver
/// "recursosPermitidos" abaixo). Validado como string livre em código, não
/// enum do Postgres, pra permitir reintroduzir papéis mais granulares
/// (ex.: ADMIN_FRANQUIA/OPERADOR) sem migração de schema.
///
/// Ajuste "Super Admin pode adicionar mais de 1 usuário numa franquia" (ver
/// docs/plano-multi-franquia.md, seção 8, item 8): a trava
/// @@unique([franquiaId]) que existia aqui foi REMOVIDA — uma franquia
/// passa a poder ter N usuários, cada um com login próprio, compartilhando
/// as integrações da franquia (Asaas/webhook/Drive) mas com
/// "recursosPermitidos" independentes. Isso NÃO muda o comportamento pra
/// quem já tem 1 usuário só (nada é obrigatório usar) — é uma opção a mais
/// que o SUPER_ADMIN aciona em Controle Geral quando quiser.
model Usuario {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  senhaHash     String    @map("senha_hash")
  papel         String
  franquiaId    String?   @map("franquia_id")
  franquia      Franquia? @relation(fields: [franquiaId], references: [id])
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now()) @map("criado_em")
  ultimoLoginEm DateTime? @map("ultimo_login_em")
  /// Restrição de telas por USUÁRIO (movido de Franquia.recursosPermitidos
  /// — ver docblock legado lá, e docs/plano-multi-franquia.md seção 8, item
  /// 8). Chaves válidas: RECURSOS (src/config/recursos.js). Sempre vazio
  /// (`[]`, sem sentido) pro SUPER_ADMIN — nunca lido pra esse papel (ver
  /// middleware/exigirRecurso.js, sempre irrestrito). A migração que
  /// introduziu este campo já copiou, pro único Usuario que cada franquia
  /// tinha até então, exatamente o "recursos_permitidos" que estava na
  /// Franquia dele — ninguém perdeu acesso ao que já tinha.
  recursosPermitidos String[] @default([]) @map("recursos_permitidos")

  @@map("usuarios")
}

model Associado {
  id                     String    @id @default(uuid())
  franquiaId             String    @map("franquia_id")
  franquia               Franquia  @relation(fields: [franquiaId], references: [id])
  cpfCnpj                String    @unique @map("cpf_cnpj")
  nome                   String
  telefone               String
  email                  String?
  emNegociacao           Boolean   @default(false) @map("em_negociacao")
  observacao             String?
  observacaoAtualizadaEm DateTime? @map("observacao_atualizada_em")
  bloqueado              Boolean   @default(false)
  emJuridico             Boolean   @default(false) @map("em_juridico")
  cicloResetadoEm        DateTime? @map("ciclo_resetado_em")
  criadoEm               DateTime  @default(now()) @map("criado_em")
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em")

  cobrancas       Cobranca[]
  historicoStatus HistoricoStatusAssociado[]
  cardsJuridico   CardJuridico[]

  @@index([cpfCnpj])
  @@index([franquiaId])
  @@map("associados")
}

model Cobranca {
  id             String    @id @default(uuid())
  associadoId    String    @map("associado_id")
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  idExterno      String?   @unique @map("id_externo")
  valor          Decimal   @db.Decimal(12, 2)
  vencimento     DateTime  @db.Date
  diasDiferenca  Int       @map("dias_diferenca")
  linkPagamento  String?   @map("link_pagamento")
  descricao      String?
  status         String    @default("pending")
  sincronizadoEm DateTime  @default(now()) @map("sincronizado_em")
  /// Preenchido só quando o backend reconcilia a cobrança de "quitada" (ver
  /// POST /api/sync): marca quando ela deixou de aparecer no payload do n8n
  /// (ou seja, sumiu da listagem PENDING/OVERDUE do Asaas — geralmente
  /// porque foi paga). Nunca é setado a partir de payload externo.
  quitadaEm      DateTime? @map("quitada_em")

  @@index([associadoId])
  @@index([status])
  @@index([idExterno])
  @@map("cobrancas")
}

/// Histórico unificado de mudanças de status do associado — substitui as
/// antigas tabelas "historico_negociacao" e "historico_bloqueio" (uma
/// terceira nunca chegou a existir para "em_juridico", que não tinha
/// histórico nenhum antes desta tabela). Uma linha por mudança de qualquer
/// um dos três campos booleanos de status, discriminada por "campo" — ver
/// CAMPOS_HISTORICO_STATUS em src/controllers/associados.controller.js.
/// Consultada tanto pela seção "Histórico" do modal de detalhe
/// (GET /api/associados/:cpf_cnpj, todos os campos juntos, mais recente
/// primeiro) quanto pelo contador de bloqueios
/// (GET .../bloqueios/contador, filtrando campo = "bloqueado").
model HistoricoStatusAssociado {
  id             String    @id @default(uuid())
  associadoId    String    @map("associado_id")
  associado      Associado @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  campo          String
  statusAnterior Boolean   @map("status_anterior")
  statusNovo     Boolean   @map("status_novo")
  alteradoEm     DateTime  @default(now()) @map("alterado_em")

  @@index([associadoId])
  @@index([campo])
  @@map("historico_status_associado")
}

/// Tabela de configurações persistidas em runtime (ex.: asaas_api_key,
/// drive_pasta_raiz_id, google_service_account_json — ver
/// docs/plano-multi-franquia.md, seção 3), para permitir leitura/alteração
/// sem depender só de variáveis de ambiente. Chave primária composta
/// (chave, franquia_id): cada franquia tem sua própria linha por chave de
/// configuração, sem enxergar a das outras.
model Configuracao {
  chave        String
  franquiaId   String   @map("franquia_id")
  franquia     Franquia @relation(fields: [franquiaId], references: [id])
  valor        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@id([chave, franquiaId])
  @@index([franquiaId])
  @@map("configuracoes")
}

/// Chaves de API para integrações externas (n8n, etc.) — substitui o antigo
/// modelo de chave única guardada em "configuracoes" (chave "api_key").
/// Suporta N chaves simultâneas, cada uma com nome/rótulo próprio, pra
/// permitir revogar uma integração sem derrubar as outras (ver
/// src/services/apiKeys.service.js). Nunca guarda a chave em texto puro —
/// só o hash SHA-256 (usado pra validar em src/middleware/auth.js) e os
/// últimos caracteres (usados só pra exibir mascarada na tela de
/// Configurações). "revogadaEm" null = chave ativa; a linha nunca é
/// deletada, pra manter histórico. A chave única antiga (tabela
/// "configuracoes") é importada automaticamente pra cá na primeira
/// listagem/validação depois desta migração — ver
/// migrarChaveLegadaSeNecessario em apiKeys.service.js.
model ApiKey {
  id                String    @id @default(uuid())
  franquiaId        String    @map("franquia_id")
  franquia          Franquia  @relation(fields: [franquiaId], references: [id])
  nome              String
  hash              String    @unique
  tamanho           Int
  ultimosCaracteres String    @map("ultimos_caracteres")
  criadaEm          DateTime  @default(now()) @map("criada_em")
  ultimoUsoEm       DateTime? @map("ultimo_uso_em")
  revogadaEm        DateTime? @map("revogada_em")

  @@index([revogadaEm])
  @@index([franquiaId])
  @@map("api_keys")
}

/// Registro de cada execução de POST /api/sync, usado por GET /api/config/sync-log.
model SyncLog {
  id                         String   @id @default(uuid())
  franquiaId                 String   @map("franquia_id")
  franquia                   Franquia @relation(fields: [franquiaId], references: [id])
  executadoEm                DateTime @default(now()) @map("executado_em")
  totalAssociadosProcessados Int      @map("total_associados_processados")
  sucesso                    Boolean

  @@index([executadoEm])
  @@index([franquiaId])
  @@map("sync_log")
}

/// Registro de cada envio do fluxo de Cadastro/Faturamento (substitui o
/// gatilho do Kommo) — guarda o payload completo enviado pelo formulário e
/// o resultado do repasse para o webhook do n8n (ver POST /api/cadastros).
model CadastroEnviado {
  id             String   @id @default(uuid())
  franquiaId     String   @map("franquia_id")
  franquia       Franquia @relation(fields: [franquiaId], references: [id])
  payload        Json
  status         String   @default("enviado")
  respostaN8n    String?  @map("resposta_n8n")
  /// Preenchidos a partir da resposta do webhook do n8n quando "sucesso" —
  /// ver enviarParaN8n em cadastros.controller.js. Ficam null em caso de
  /// erro (o motivo vai em respostaN8n) ou se o n8n ainda não os enviar.
  linkPagamento  String?  @map("link_pagamento")
  clienteAsaasId String?  @map("cliente_asaas_id")
  pedidoBlingId  String?  @map("pedido_bling_id")
  /// Nome usado para a pasta criada no Google Drive (ver
  /// src/services/contratos-geracao.service.js) — preenchido pelo campo
  /// "Nome da pasta" do formulário de Cadastro, opcional.
  nomePasta         String?  @map("nome_pasta")
  /// Ids de ModeloContrato selecionados no formulário ("Contratos a
  /// gerar") — snapshot do que foi escolhido no momento do envio; não é
  /// afetado se o modelo referenciado for desativado depois (soft-delete).
  modelosContratoIds String[] @map("modelos_contrato_ids")
  /// Preenchido de forma assíncrona depois que a pasta é criada no Drive —
  /// null enquanto a geração ainda não rodou ou se ela falhar.
  pastaDriveId   String?  @map("pasta_drive_id")
  /// Array de { modeloContratoId, nome, driveFileId, driveFileUrl } — um
  /// item por contrato gerado com sucesso. Preenchido de forma assíncrona,
  /// junto com pastaDriveId.
  arquivosGerados Json?   @map("arquivos_gerados")
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@index([status])
  @@index([franquiaId])
  @@map("cadastros_enviados")
}

/// Modelos de contrato (HTML rich-text com placeholders {{...}}) usados
/// para gerar automaticamente documentos .docx ao salvar um Cadastro (ver
/// tela /contratos e src/services/contratos-geracao.service.js). Nunca é
/// hard-deletado (ver DELETE /api/contratos/:id) — só marcado
/// ativo=false, pra não quebrar CadastroEnviado.modelosContratoIds de
/// envios antigos que já referenciam esse modelo.
model ModeloContrato {
  id           String   @id @default(uuid())
  franquiaId   String   @map("franquia_id")
  franquia     Franquia @relation(fields: [franquiaId], references: [id])
  nome         String
  /// "TERMO" | "ADITIVO" — só pra organizar a listagem na tela /contratos.
  tipo         String
  /// HTML gerado pelo editor rich text (Tiptap), com placeholders no
  /// formato {{Nome Da Variável}} como texto simples dentro do conteúdo.
  conteudo     String   @db.Text
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ativo])
  @@index([franquiaId])
  @@map("modelos_contrato")
}

/// Refresh tokens da sessão do painel (ver src/services/refreshTokens.service.js
/// e "Autenticação: access token curto + refresh token" no README). Guarda só
/// o hash SHA-256 do valor real (nunca o token em texto puro — mesmo padrão
/// de ApiKey), com um "id" próprio (uuid) usado como "jti" (claim único)
/// dentro do access token correspondente — isso garante que dois logins
/// nunca produzem o mesmo access token, mesmo com as mesmas credenciais no
/// mesmo segundo (jwt.sign é determinístico: mesmo header+payload+segredo
/// sempre gera a mesma assinatura; sem um "jti" único por sessão, dois
/// logins dentro do mesmo segundo geravam tokens byte-a-byte idênticos).
/// "usuario" hoje é sempre o admin único (ADMIN_USER). O modelo Usuario já
/// existe (multi-franquia, ver acima), mas a troca deste campo por um
/// usuarioId (FK) fica pra Fase 2 (autenticação) da migração multi-franquia
/// — só faz sentido backfillar depois que o SUPER_ADMIN é semeado a partir
/// de ADMIN_USER/ADMIN_PASSWORD (docs/plano-multi-franquia.md, seção 2),
/// que é lógica de aplicação, não de migração SQL.
/// "revogadoEm" null = sessão ativa; nunca deletado, mantém histórico.
model RefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String    @unique @map("token_hash")
  usuario     String
  criadoEm    DateTime  @default(now()) @map("criado_em")
  expiraEm    DateTime  @map("expira_em")
  revogadoEm  DateTime? @map("revogado_em")
  ultimoUsoEm DateTime? @map("ultimo_uso_em")

  @@index([usuario])
  @@index([revogadoEm])
  @@map("refresh_tokens")
}

/// Lista manual de cobranças do Asaas a excluir do cálculo de Taxa de
/// Inadimplência (ver GET /api/inadimplencia/resumo), independente da
/// exclusão automática por palavra-chave (ver "configuracoes" ->
/// "inadimplencia_palavras_excluidas"). Gerenciada via
/// GET/POST/DELETE /api/inadimplencia/exclusoes.
model CobrancaIgnorada {
  id             String   @id @default(uuid())
  franquiaId     String   @map("franquia_id")
  franquia       Franquia @relation(fields: [franquiaId], references: [id])
  asaasPaymentId String   @unique @map("asaas_payment_id")
  motivo         String?
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@index([franquiaId])
  @@map("cobrancas_ignoradas")
}

/// Kanban "Jurídico" — aba nova (ver docs/plano-multi-franquia.md e escopo
/// pedido pelo usuário). Etapas (colunas) configuráveis por franquia:
/// criar, renomear, reordenar (drag and drop, "ordem" reindexado no
/// controller a cada reordenação — ver juridico.controller.js), excluir
/// (com confirmação se tiver card dentro). ESCOPO_DIRETO na Prisma Client
/// Extension de isolamento (ver prismaComEscopo.js) — franquiaId direto na
/// própria tabela, mais simples que o desenho por relação usado em
/// Cobranca/HistoricoStatusAssociado (não fazia sentido aqui: etapa não
/// "pertence" a nenhum outro tenant-model, é ela mesma o tenant-model).
model EtapaJuridico {
  id         String   @id @default(uuid())
  franquiaId String   @map("franquia_id")
  franquia   Franquia @relation(fields: [franquiaId], references: [id])
  nome       String
  /// Posição na ordem das colunas (0-based) — reindexado por inteiro a cada
  /// criação/exclusão/reordenação, nunca deixado esparso.
  ordem      Int
  criadoEm   DateTime @default(now()) @map("criado_em")

  cards CardJuridico[]

  @@index([franquiaId])
  @@map("etapas_juridico")
}

/// Card do Kanban Jurídico — duas origens possíveis (ver escopo do
/// pedido), mutuamente exclusivas (validado no controller, não no schema):
///   - Vinculado a um Associado já cadastrado ("associadoId" preenchido,
///     "titulo"/"descricao"/"observacoes" ficam null): nome/cpf_cnpj/
///     telefone/valor em aberto são exibidos SEMPRE ao vivo a partir da
///     relação — nunca copiados estaticamente pro card (ver serializeCard
///     em juridico.controller.js, que busca a relação a cada listagem).
///   - Livre ("titulo" preenchido, "associadoId" null): título + descrição
///     + observações próprios do card.
/// "responsavel"/"prazo" são opcionais e válidos pros dois casos. Também
/// ESCOPO_DIRETO (mesma justificativa de EtapaJuridico) — o vínculo opcional
/// com Associado é validado manualmente no controller (confirma que
/// "associado_id" pertence à mesma franquia antes de aceitar), já que a
/// extension só valida automaticamente esse tipo de relação pros models
/// ESCOPO_RELACAO (Cobranca/HistoricoStatusAssociado).
model CardJuridico {
  id          String        @id @default(uuid())
  franquiaId  String        @map("franquia_id")
  franquia    Franquia      @relation(fields: [franquiaId], references: [id])
  etapaId     String        @map("etapa_id")
  etapa       EtapaJuridico @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  /// Posição dentro da etapa (0-based) — reindexado por inteiro a cada
  /// criação/exclusão/movimentação entre colunas.
  ordem       Int
  associadoId String?    @map("associado_id")
  associado   Associado? @relation(fields: [associadoId], references: [id], onDelete: Cascade)
  titulo      String?
  descricao   String?
  /// Campo livre extra, adicionado depois do MVP inicial (ver escopo do
  /// ajuste "Observações nos cards do Jurídico") — MESMA regra de
  /// visibilidade de "descricao": só existe pra card livre (origem
  /// "titulo"), nunca pra card vinculado a associado (mesma validação de
  /// "temAssociado && campoPreenchido(...)" em juridico.controller.js).
  observacoes String?
  responsavel String?
  prazo       DateTime?  @db.Date
  /// Preenchido (data/hora atual) toda vez que "etapaId" muda via
  /// PATCH /api/juridico/cards/:id/mover — registro simples de "quando
  /// mudou de etapa pela última vez", complementar ao log completo em
  /// HistoricoCardJuridico (que registra o mesmo evento com mais detalhe,
  /// ver abaixo).
  etapaAlteradaEm DateTime? @map("etapa_alterada_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  @@index([franquiaId])
  @@index([etapaId])
  @@index([associadoId])
  @@map("cards_juridico")
}

/// Histórico de alterações de um CardJuridico (ver escopo do ajuste "Log de
/// atualização dos cards do Jurídico") — nunca sobrescreve o card, só
/// acrescenta um registro por evento: criação ("campoAlterado" =
/// "criacao"), edição de um campo ("campoAlterado" =
/// "responsavel"|"prazo"|"titulo"|"descricao"|"observacoes", com
/// "valorAnterior"/"valorNovo" preenchidos), mudança de etapa
/// ("campoAlterado" = "etapa", "valorAnterior"/"valorNovo" = id da
/// EtapaJuridico origem/destino) e exclusão ("campoAlterado" = "exclusao",
/// registrado ANTES do delete de verdade — ver
/// juridico.controller.js:removerCard). Mesmo espírito de
/// HistoricoStatusAssociado, mas SEM foreign key pra CardJuridico nem pra
/// Usuario, de propósito: precisa sobreviver tanto à exclusão do card (o
/// log "exclusao" só faz sentido se continuar consultável depois que o
/// card já não existe mais) quanto a qualquer mudança futura em como
/// usuários são removidos/arquivados — mesmo raciocínio já documentado em
/// RefreshToken.usuario (docs/plano-multi-franquia.md, seção 1.4): uma
/// coluna "solta" que guarda um id, não uma relação rígida com FK, evita
/// acoplar a integridade deste log ao ciclo de vida de outra tabela.
/// "usuarioId" fica null quando a ação vem de uma sessão de API key (ver
/// middleware/auth.js — "req.auth.type === 'api_key'" não tem
/// "req.auth.user") — não deveria acontecer na prática hoje (o Kanban
/// Jurídico não é usado por nenhuma integração externa), mas o campo aceita
/// esse caso sem quebrar. ESCOPO_DIRETO na extension de isolamento (mesma
/// justificativa de EtapaJuridico/CardJuridico). Sem tela própria ainda
/// (fica pra uma rodada futura, ver escopo do ajuste) — só a estrutura e o
/// registro acontecendo.
model HistoricoCardJuridico {
  id            String   @id @default(uuid())
  cardId        String   @map("card_id")
  franquiaId    String   @map("franquia_id")
  franquia      Franquia @relation(fields: [franquiaId], references: [id])
  campoAlterado String   @map("campo_alterado")
  valorAnterior String?  @map("valor_anterior")
  valorNovo     String?  @map("valor_novo")
  usuarioId     String?  @map("usuario_id")
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@index([cardId])
  @@index([franquiaId])
  @@map("historico_card_juridico")
}
