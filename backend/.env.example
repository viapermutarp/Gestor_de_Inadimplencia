# ==========================================================
# Gestor de Inadimplência - Variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# ==========================================================

# Porta em que a API vai escutar
PORT=3000

# String de conexão do PostgreSQL usada pelo Prisma.
# Ao rodar via docker-compose, o host "db" é o nome do serviço do banco.
DATABASE_URL=postgresql://postgres:postgres@db:5432/gestor_inadimplencia?schema=public

# Chave de API fixa usada pelas integrações externas.
# Deve ser enviada no header: Authorization: Bearer <API_KEY>
# Se deixada em branco, uma chave forte é GERADA AUTOMATICAMENTE na primeira
# inicialização da aplicação e gravada neste arquivo .env.
API_KEY=

# Segredo usado para assinar os tokens JWT retornados por POST /api/login.
# Também é gerado automaticamente se deixado em branco.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Credenciais fixas do painel administrativo (usadas em POST /api/login)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Credenciais do container do Postgres (usadas pelo docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestor_inadimplencia

# URL do webhook n8n que sincroniza sob demanda os dados do Asaas (busca no
# Asaas, agrupa e chama POST /api/sync internamente) — usado por
# POST /api/sync/atualizar, acionado pelo botão "Atualizar" do Dashboard.
# Pode mudar entre ambientes (dev/staging/produção), por isso fica só em
# variável de ambiente, sem UI de configuração em runtime. Se deixada em
# branco, POST /api/sync/atualizar responde 502.
N8N_SYNC_WEBHOOK_URL=

# Documentos anexados ao Jurídico (ver AJUSTE 11 — "Documentos anexados ao
# associado, visíveis no card Jurídico"). Diretório raiz onde os arquivos
# são gravados em disco. Se deixada em branco, usa "<raiz do backend>/
# uploads/juridico" — funciona sem configurar nada em dev, mas em produção
# (Docker/EasyPanel) este caminho PRECISA apontar para um volume
# persistente (ver docker-compose.yml e a seção "Deploy no EasyPanel" do
# README), senão os arquivos somem a cada novo deploy.
JURIDICO_UPLOADS_DIR=

# Tamanho máximo (em bytes) de um documento anexado no Jurídico.
# Default: 20MB (20971520 bytes).
JURIDICO_UPLOAD_MAX_BYTES=

# AJUSTE 14 — domínio público desta API (sem barra no final), usado só para
# MONTAR a URL do webhook do Asaas mostrada em Configurações
# (GET /api/config/asaas-webhook), pra copiar/colar direto no cadastro do
# webhook no painel do Asaas. Ex.: https://api.viapermuta.com.br
# Se deixada em branco, a tela mostra só o caminho relativo
# (/api/asaas/webhook/<franquia_id>) — o webhook em si (POST) funciona
# normalmente de qualquer jeito, isto é só uma conveniência de exibição.
PUBLIC_BASE_URL=
